# ---------------------------------------------------------------------------
# Environment variables for the admin panel (Vite — must be prefixed with VITE_)
# Copy this file to .env and adjust the values for your environment.
# These are baked into the bundle at BUILD time (npm run build / docker build).
# ---------------------------------------------------------------------------

# OAuth / main backend (authentication, users, products, media, ...)
# Development: http://localhost:8085/
# Production:  https://rastak-oauth.webx.ir/
VITE_BASE_URL=https://rastak-oauth.webx.ir/

# GRC backend (risk / compliance / sustainability / maturity modules) — /api/v1
# Development: http://localhost:3000/api/v1/
# Production:  https://rastak-core.webx.ir/api/v1
VITE_GRC_BASE_URL=http://localhost:3000/api/v1/
